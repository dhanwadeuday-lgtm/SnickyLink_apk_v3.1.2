APP_ENV=production
DATABASE_URL=postgresql://snickylink:CHANGE_ME@postgres:5432/snickylink
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTO_CREATE_TABLES=false
RUN_SCHEDULER=false
RUN_EVENT_WORKER=false
CORS_ORIGINS=https://app.snickylink.app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
MEDIA_SIGNING_KEY=GENERATE_A_LONG_RANDOM_MEDIA_SECRET_32_CHARS_MINIMUM
MEDIA_BASE_URL=https://cdn.snickylink.app
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
S3_BUCKET=snickylink-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
AI_PROVIDER=vision
AI_API_KEY=
FCM_SERVER_KEY=
FCM_URL=https://fcm.googleapis.com/fcm/send
SUSPENSION_REPORT_THRESHOLD=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@snickylink.app
SMTP_TLS=true
PASSWORD_RESET_URL=https://app.snickylink.app/reset-password
REDIS_HOST=redis
REDIS_PORT=6379
